<?xml version="1.0" encoding="utf-8"?>
<!--
  明文 HTTP 是**有意允许**的：网关跑在局域网（http://192.168.x.x:8788），
  而 Android 9 起默认禁止明文流量。要改成 https 就得在手机上装自签证书，
  对自用场景过度工程。风险补偿：设备令牌 + 只在内网使用。
  如果以后要跨公网，必须换成 Tailscale（走加密隧道）或加 TLS。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 扫码配对：只在配对页用于识别电脑屏幕上的二维码，不拍照、不上传 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ 查询 TTS / 语音识别服务需要显式声明 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="DSH"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DshMobile"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DshMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              扫码配对的深链：系统相机/微信扫到 dshmobile://pair?... 时可以直接打开 App。
              只接受 pair 这一个 host，别的一律不处理（MainActivity 里还有一道校验）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dshmobile" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
          前台服务：HyperOS 的后台策略很激进，普通后台长连接活不过几分钟。
          必须用前台服务（带常驻通知）才能稳定收到「跑了十分钟的那一轮」的结果。
        -->
        <service
            android:name=".net.GatewayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
